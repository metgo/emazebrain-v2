{
  "name": "@emb/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "eMazeBrain Admin Web App (design doc C1): React 19 SPA for clinic staff. The Clinic and Home store apps wrap this build with Capacitor.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
