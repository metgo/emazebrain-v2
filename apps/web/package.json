    "@emb/game-sdk": "workspace:*",
    "@emb/metrics": "workspace:*",
    "@emb/progression": "workspace:*",
    "@emb/ui": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/rubik": "5.3.0",
    "@tanstack/react-query": "5.104.5",
    "better-auth": "1.7.7",
    "lucide-react": "1.61.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-intl": "12.1.5",
    "react-router": "7.18.4"
  },
  "devDependencies": {
